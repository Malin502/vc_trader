# Testnet 資格情報（必ず 600 で配置し、リポジトリにコミットしない）
#
# main_live / preflight_reconcile / paper_report は BINANCE_API_KEY を読む。
# 既存の M4b スモーク（testnet_smoke_m4b.py）は TESTNET_* を読む。
# 両方を同じ Testnet キーで埋めておくと、どのスクリプトでも同じ口座を見る。
#
#   chmod 600 .env.testnet

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# main_live が読む名前（値は上と同じ Testnet キー）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 通知先（未設定なら通知は無効。ログには残る）
DISCORD_WEBHOOK_URL=
